# Copy these into Vercel > Project > Settings > Environment Variables.
# NEVER commit real values to GitHub.

# The login for /admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password-at-least-10-characters

# A long random text (32+ characters) used to sign the login cookie
ADMIN_SESSION_SECRET=paste-a-long-random-text-here-32-characters-or-more

# From Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Optional. Default is site-media
SUPABASE_BUCKET=site-media
